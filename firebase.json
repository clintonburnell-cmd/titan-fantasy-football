{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      ".firebase/**",
      "firebase-debug.log",
      "firestore.rules",
      "README.md",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(png|svg)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
