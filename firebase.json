{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      ".firebase/**",
      "firebase-debug.log",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "CLAUDE.md",
      "tests/**",
      "**/.git/**",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {"source": "/api/trade-values", "function": {"functionId": "tradeValues", "region": "us-central1"}},
      {"source": "/api/news", "function": {"functionId": "espnNews", "region": "us-central1"}},
      {"source": "/api/game-context", "function": {"functionId": "gameContext", "region": "us-central1"}},
      {"source": "/api/scores", "function": {"functionId": "nflScores", "region": "us-central1"}},
      {"source": "/api/yahoo/callback", "function": {"functionId": "yahooCallback", "region": "us-central1"}},
      {"source": "/app/**", "destination": "/app/index.html"}
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/app/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/app/**",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(png|svg|jpg)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["node functions/copy-shared.js"],
    "ignore": ["node_modules", ".git", "*.local"]
  }
}
