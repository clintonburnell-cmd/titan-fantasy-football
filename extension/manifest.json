{
  "manifest_version": 3,
  "name": "Titan for Sleeper",
  "version": "0.1.0",
  "description": "Titan Fantasy Football Manager's calls on Sleeper's pages: values, buy, sell or keep, claims with a bid and a drop, and start ideas for the league you're looking at.",
  "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Titan for Sleeper"},
  "background": {"service_worker": "bg.js", "type": "module"},
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://api.sleeper.app/*", "https://firestore.googleapis.com/*", "https://titanfantasyfootball.com/*"],
  "content_scripts": [{
    "matches": ["https://sleeper.com/*", "https://www.sleeper.com/*", "https://sleeper.app/*"],
    "js": ["engine.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "externally_connectable": {"matches": ["https://titanfantasyfootball.com/*"]}
}
