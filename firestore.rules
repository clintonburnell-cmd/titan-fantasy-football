rules_version = '2';

// Titan Fantasy Football. Each signed-in person can read and write only their
// own data, stored under users/{their uid}. Nothing else is readable by anyone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
